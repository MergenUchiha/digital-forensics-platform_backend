# ─── Database ──────────────────────────────────────────────────────────────────
# SQLite file, relative to the prisma/ directory.
DATABASE_URL="file:./dev.db"

# ─── Runtime ───────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=5001

# ─── Authentication ────────────────────────────────────────────────────────────
# Required. The application refuses to start without it.
# Generate one with:  openssl rand -base64 48
JWT_SECRET=replace-me-with-a-long-random-string
JWT_EXPIRES_IN=7d

# Credentials for the administrator account created by `npm run prisma:seed`.
# Required only when seeding.
SEED_ADMIN_EMAIL=admin@forensics.local
SEED_ADMIN_PASSWORD=replace-me-before-seeding

# ─── HTTP ──────────────────────────────────────────────────────────────────────
# Comma-separated list of origins allowed to call the API.
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# Swagger UI at /api/docs. Defaults to off when NODE_ENV=production.
SWAGGER_ENABLED=true

# ─── Evidence uploads ──────────────────────────────────────────────────────────
# Maximum size of a single uploaded file, in megabytes.
MAX_UPLOAD_MB=100

# ─── SIEM forwarding ───────────────────────────────────────────────────────────
# Optional. When both are set, request logs are forwarded to a SIEM and the
# /api/logs endpoints require this key in the x-api-key header. When unset,
# those endpoints are disabled outright — they used to be wide open instead.
SIEM_URL=
SIEM_API_KEY=
